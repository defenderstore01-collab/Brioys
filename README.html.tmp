<style>
:root{
  --navy:#0d2a52;--navy2:#163d73;--blue:#2d7ff9;--green:#20b56b;--orange:#ff9d31;
  --ink:#10213d;--muted:#64748b;--line:#e7edf4;--bg:#f8fafc;--card:#fff;
  --shadow:0 18px 50px rgba(16,33,61,.08);--radius:20px;
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;line-height:1.5}button,input{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}img{display:block;max-width:100%}
.container{width:min(1380px,calc(100% - 48px));margin:auto}
.announcement{background:var(--navy);color:#fff;font-size:12px;font-weight:700}.announce-inner{height:34px;display:flex;align-items:center;justify-content:space-between;gap:18px}.announce-item{display:flex;align-items:center;gap:8px;white-space:nowrap}.announce-item svg{width:15px;height:15px;opacity:.9}
header{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}.nav{height:76px;display:flex;align-items:center;gap:30px}.brand{display:flex;align-items:center;min-width:210px}.brand img{width:158px;height:60px;object-fit:contain;object-position:center}.navlinks{display:flex;align-items:center;gap:28px;flex:1;font-size:13px;font-weight:700;color:#263b5b}.navlinks a{position:relative}.navlinks a:hover{color:var(--blue)}.navlinks a:after{content:"";position:absolute;left:0;bottom:-9px;width:0;height:2px;background:var(--blue);transition:.2s}.navlinks a:hover:after{width:100%}.nav-actions{display:flex;align-items:center;gap:10px}.search{width:245px;height:42px;border:1px solid var(--line);background:#f6f8fb;border-radius:999px;display:flex;align-items:center;padding:0 14px;gap:8px}.search input{border:0;outline:0;background:transparent;width:100%;font-size:12px}.icon{width:40px;height:40px;border:0;background:transparent;color:var(--ink);display:grid;place-items:center;border-radius:50%}.icon:hover{background:#f1f5f9}.cart{position:relative}.cart-badge{position:absolute;right:-1px;top:-2px;background:var(--navy);color:#fff;width:18px;height:18px;border-radius:50%;display:grid;place-items:center;font-size:10px;font-weight:800}.mobile-menu{display:none}
.breadcrumbs{font-size:12px;color:#6b7b91;padding:18px 0;display:flex;gap:8px;align-items:center}.breadcrumbs a:hover{color:var(--blue)}
