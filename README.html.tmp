</main>
<footer id="support"><div class="container footer-grid"><div class="footer-brand"><img src="assets/brioys-logo.png" alt="Brioys"><p>More Than Just a Store — a clean, modern shopping experience.</p></div><div><h4>Shop</h4><a href="#shop">Featured Product</a><a href="#related">Related Products</a><a href="#video">Product Video</a></div><div><h4>Support</h4><a href="javascript:orderWhatsApp()">WhatsApp</a><a href="#details">Shipping &amp; Returns</a><a href="#top">Back to top ↑</a></div></div><div class="container copyright">© <span id="year"></span> Brioys. All rights reserved.</div></footer>
<a class="wa-float" href="https://wa.me/923123456789?text=Hi%20Brioys%2C%20I%20am%20interested%20in%20the%20Magnetic%20Train%20Track%20Builder%20Set." target="_blank" aria-label="Chat on WhatsApp"><small></small><svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20l1.2-4.1A8.5 8.5 0 1 1 20.5 11.5Z" stroke="white" stroke-width="1.8"/><path d="M8.7 7.8c.2-.4.5-.4.8-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.2.1.4 0 .6l-.5.7c-.1.2-.1.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.1.6 0l.8-.5c.2-.1.4-.1.6 0l1.7.8c.2.1.3.3.3.5v.5c0 .3-.1.6-.4.8-.5.3-1.1.5-1.7.4-1.2-.2-2.8-1-4.1-2.3-1.3-1.3-2.1-2.9-2.3-4.1-.1-.6.1-1.2.4-1.7.3-.3.7-.5 1.1-.5Z" fill="white"/></svg></a>
<div class="mobile-bottom"><button class="btn primary" onclick="addToCart()">Add to Cart</button><button class="btn buy" onclick="buyNow()">Buy Now</button></div>
<div class="toast" id="toast"><img src="assets/product-main.png" alt=""><div><strong id="toastTitle">Order activity</strong><span id="toastText">A customer just placed an order.</span></div><button class="close-toast" onclick="hideToast()">×</button></div>
<div class="drawer-backdrop" id="drawerBackdrop" onclick="closeCart()"></div><aside class="drawer" id="cartDrawer"><div class="drawer-head"><strong>Your Cart</strong><button class="icon" onclick="closeCart()">×</button></div><div class="drawer-item"><img src="assets/product-main.png" alt="Product"><div><strong>Magnetic Train Track Builder Set</strong><div style="font-size:12px;color:#708098;margin-top:4px">Qty: <span id="drawerQty">0</span></div><div style="font-weight:900;margin-top:5px">Rs. 6,500</div></div></div><div class="drawer-total"><span>Total</span><span id="drawerTotal">Rs. 0</span></div><button class="btn buy" style="width:100%" onclick="buyNow()">Buy Now</button></aside>
<script>
const WHATSAPP_NUMBER='923123456789';
const PRODUCT_PRICE=6500;
let stock=5, cartQty=0, qty=1;
const demoActivities=[
  ['Hassan','from Lahore'],['Ayesha','from Islamabad'],['Ali','from Karachi'],['Usman','from Faisalabad'],['Sara','from Rawalpindi'],['Hamza','from Gujranwala']
];
let activityIndex=0;
document.getElementById('year').textContent=new Date().getFullYear();
function setImage(src,el){const img=document.getElementById('mainImage');img.style.opacity='.35';setTimeout(()=>{img.src=src;img.style.opacity='1'},120);document.querySelectorAll('.thumb').forEach(x=>x.classList.remove('active'));el.classList.add('active')}
function changeQty(n){qty=Math.max(1,Math.min(stock,qty+n));document.getElementById('qty').textContent=qty}
function addToCart(){if(stock<=0){showToast('Out of stock','This product is currently unavailable.');return}cartQty+=qty;document.getElementById('cartBadge').textContent=cartQty;document.getElementById('drawerQty').textContent=cartQty;document.getElementById('drawerTotal').textContent='Rs. '+(cartQty*PRODUCT_PRICE).toLocaleString();showToast('Added to cart',qty+' item'+(qty>1?'s':'')+' added.');}
function buyNow(){if(stock<=0){showToast('Out of stock','This product is currently unavailable.');return}orderWhatsApp();}
function orderWhatsApp(){const text=encodeURIComponent('Hi Brioys, I want to order the Magnetic Train Track Builder Set (123 Pieces). Quantity: '+qty+'.');window.open('https://wa.me/'+WHATSAPP_NUMBER+'?text='+text,'_blank');}
function openCart(){document.getElementById('cartDrawer').classList.add('open');document.getElementById('drawerBackdrop').classList.add('open')}
function closeCart(){document.getElementById('cartDrawer').classList.remove('open');document.getElementById('drawerBackdrop').classList.remove('open')}
function toggleMobileMenu(){const nav=document.querySelector('.navlinks');if(nav.style.display==='flex'){nav.style.display=''}else{nav.style.display='flex';nav.style.position='absolute';nav.style.left='14px';nav.style.right='14px';nav.style.top='68px';nav.style.background='#fff';nav.style.padding='18px';nav.style.border='1px solid var(--line)';nav.style.borderRadius='16px';nav.style.flexDirection='column';nav.style.boxShadow='0 18px 45px rgba(16,33,61,.15)'}}
function showTab(btn,id){document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));btn.classList.add('active');document.querySelectorAll('.tab-panel').forEach(x=>x.style.display='none');document.getElementById(id).style.display='block'}
function searchProducts(q){q=q.toLowerCase().trim();document.querySelectorAll('.related-card').forEach(c=>c.style.display=c.dataset.name.includes(q)?'block':'none')}
function showToast(title,text){document.getElementById('toastTitle').textContent=title;document.getElementById('toastText').textContent=text;document.getElementById('toast').classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(hideToast,4200)}
function hideToast(){document.getElementById('toast').classList.remove('show')}
function showDemoActivity(){const [name,place]=demoActivities[activityIndex%demoActivities.length];activityIndex++;showToast(name+' placed an order',place+' • Magnetic Train Track Builder Set');}
// Demo-only activity timing. Connect this to real order data before production use.
setTimeout(showDemoActivity,7000);setInterval(showDemoActivity,10000);
// Keep stock tied to actual purchase/cart logic. Do not randomly alter real inventory.
function registerSuccessfulOrder(){if(stock>0){stock=Math.max(0,stock-1);updateStock()}}
function updateStock(){document.getElementById('stockText').textContent=stock>0?'In Stock | Only '+stock+' left':'Out of Stock';document.getElementById('stockBar').style.width=Math.max(0,Math.min(100,stock/5*100))+'%';if(stock<=0){document.querySelectorAll('.btn.buy,.btn.primary').forEach(b=>b.disabled=true)}}
</script>
</body>
</html>
