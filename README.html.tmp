d:var(--navy);border-radius:99px;width:20%;transition:width .45s ease}.description{font-size:14px;color:#586b84;margin:14px 0 20px}.benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:18px 0 20px}.benefit{font-size:11px;color:#52647c;display:flex;gap:8px;align-items:flex-start}.benefit svg{width:21px;min-width:21px;height:21px;color:var(--navy)}.qty-row{display:flex;align-items:center;gap:12px;margin:10px 0 14px}.qty{height:42px;border:1px solid var(--line);background:#fff;border-radius:999px;display:flex;align-items:center}.qty button{border:0;background:transparent;width:40px;height:40px;color:var(--ink);font-size:19px}.qty span{min-width:30px;text-align:center;font-weight:800}.cta-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.btn{border:0;border-radius:999px;height:46px;font-weight:850;display:flex;align-items:center;justify-content:center;gap:9px;transition:transform .2s,box-shadow .2s,background .2s}.btn:hover{transform:translateY(-2px)}.primary{background:var(--navy);color:#fff;box-shadow:0 10px 25px rgba(13,42,82,.18)}.buy{background:var(--blue);color:#fff;box-shadow:0 10px 25px rgba(45,127,249,.18)}.wa-btn{background:var(--green);color:#fff}.cod{background:#fff0db;color:#a96408}.btn:active{transform:translateY(0) scale(.98)}.delivery{display:flex;gap:20px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:16px;padding-top:15px;color:#596b83;font-size:11px}.delivery span{display:flex;gap:6px;align-items:center}.check-note{margin-top:14px;padding:11px 13px;background:#f5f8fc;border-radius:12px;color:#5a6c83;font-size:12px;font-weight:700}
.section{padding:44px 0}.tabs{display:flex;gap:36px;border-bottom:1px solid var(--line);margin-bottom:18px}.tab{border:0;background:transparent;padding:0 0 13px;color:#60728a;font-weight:800;font-size:13px;position:relative}.tab.active{color:var(--navy)}.tab.active:after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--navy)}.detail-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:30px}.detail-copy h2{font-size:20px;margin:0 0 10px}.detail-copy p{font-size:14px;color:#64748b}.video-card{position:relative;border-radius:16px;overflow:hidden;background:#111;box-shadow:var(--shadow)}.video-card video{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.video-caption{position:absolute;left:16px;bottom:14px;color:#fff;font-weight:800;font-size:13px;text-shadow:0 2px 8px #000}.feature-box{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;margin-top:14px}.feature-box ul{padding:0;margin:0;list-style:none;display:grid;gap:10px}.feature-box li{font-size:13px;color:#53667e;display:flex;gap:8px}.feature-box li:before{content:"✓";color:#1b7b4f;font-weight:900}
.related-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px}.related-head h2{font-size:25px;margin:0}.related{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 15px}.related::-webkit-scrollbar{height:7px}.related-card{flex:0 0 220px;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;scroll-snap-align:start;box-shadow:0 8px 22px rgba(16,33,61,.04)}.related-card img{aspect-ratio:1;object-fit:cover}.related-body{padding:12px}.related-body h3{font-size:14px;margin:0 0 5px}.related-body p{font-size:12px;color:#738196;margin:0}
footer{background:#0d1d33;color:#fff;margin-top:24px}.footer-grid{padding:45px 0;display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:40px}.footer-brand img{width:145px;filter:brightness(0) invert(1)}.footer p,.footer a{color:#aab7c8;font-size:13px}.footer a{display:block;margin:8px 0}.footer h4{margin:0 0 12px}.copyright{border-top:1px solid rgba(255,255,255,.1);padding:16px 0;color:#8fa0b5;font-size:11px}
.wa-float{position:fixed;right:20px;bottom:20px;z-index:90;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:#25d366;color:#fff;box-shadow:0 14px 30px rgba(37,211,102,.32);animation:pulse 2.5s infinite}.wa-float small{position:absolute;right:-1px;top:-2px;width:12px;height:12px;background:#ff3d50;border-radius:50%;border:2px solid #fff}@keyframes pulse{50%{transform:scale(1.045);box-shadow:0 17px 35px rgba(37,211,102,.46)}}
.toast{position:fixed;left:20px;bottom:20px;z-index:100;background:#fff;border:1px solid var(--line);box-shadow:0 15px 45px rgba(16,33,61,.18);border-radius:14px;padding:11px 13px;display:flex;align-items:center;gap:10px;min-width:275px;max-width:360px;transform:translateY(25px);opacity:0;pointer-events:none;transition:.35s}.toast.show{opacity:1;transform:translateY(0)}.toast img{width:42px;height:42px;border-radius:9px;object-fit:cover}.toast strong{font-size:12px;display:block}.toast span{font-size:11px;color:#708098}.toast .close-toast{margin-left:auto;border:0;background:transparent;color:#8a98a9;font-size:17px}
.mobile-bottom{display:none}.drawer-backdrop{position:fixed;inset:0;background:rgba(7,20,39,.35);z-index:110;opacity:0;pointer-events:none;transition:.2s}.drawer{position:fixed;top:0;right:-360px;width:min(360px,92vw);height:100%;background:#fff;z-index:111;box-shadow:-15px 0 40px rgba(0,0,0,.16);padding:22px;transition:.3s}.drawer.open{right:0}.drawer-backdrop.open{opacity:1;pointer-events:auto}.drawer-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:14px}.drawer-item{display:flex;gap:12px;padding:18px 0;border-bottom:1px solid var(--line)}.drawer-item img{width:65px;height:65px;object-fit:cover;border-radius:10px}.drawer-total{display:flex;justify-content:space-between;font-weight:900;margin:20px 0}
@media(max-width:1100px){.navlinks{gap:17px}.search{width:190px}.product{grid-template-columns:minmax(0,1fr) minmax(370px,.92fr)}.benefits{grid-template-columns:repeat(2,1fr)}}
@media(max-width:820px){.container{width:min(100% - 28px,1380px)}.announce-inner{overflow:hidden}.announce-item:nth-child(2),.announce-item:nth-child(3){display:none}.nav{height:68px;gap:10px}.brand{min-width:0;flex:1}.brand img{width:135px;height:52px}.navlinks{display:none}.search{display:none}.mobile-menu{display:grid}.product{grid-template-columns:1fr;gap:24px}.gallery{grid-template-columns:68px minmax(0,1fr)}.hero-image{border-radius:14px}.product-info{padding:0}.detail-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}.section{padding:34px 0}.mobile-bottom{display:flex;position:fixed;left:10px;right:10px;bottom:10px;z-index:80;background:#fff;border:1px solid var(--line);border-radius:16px;padding:8px;gap:8px;box-shadow:0 12px 35px rgba(16,33,61,.16)}.mobile-bottom .btn{flex:1;height:44px}.wa-float{bottom:80px;right:14px;width:52px;height:52px}.toast{left:12px;bottom:76px;right:12px;min-width:0;max-width:none}}
@media(max-width:520px){.product-title{font-size:28px}.subtitle{font-size:14px}.price{font-size:26px}.gallery{grid-template-columns:1fr}.thumbs{order:2;flex-direction:row;overflow-x:auto}.thumb{flex:0 0 66px}.hero-image img{aspect-ratio:1/1}.cta-grid{grid-template-columns:1fr}.tabs{gap:20px;overflow-x:auto}.tab{white-space:nowrap}.footer-grid{grid-template-columns:1fr}.announcement{font-size:10px}.benefits{gap:9px}.benefit{font-size:10px}.delivery{gap:12px}.mobile-bottom{padding:7px}.mobile-bottom .btn{font-size:12px}.related-card{flex-basis:195px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
</style>
</head>
